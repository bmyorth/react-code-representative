# URL base de la API. Por defecto `/api`: Vite la reenvía al backend local (puerto 3001).
VITE_API_BASE_URL=/api
# Activa MSW en el navegador (solo catálogo, sin autenticación ni pagos). Por defecto `false`.
VITE_ENABLE_MOCKS=false

# --- Backend local (`npm run dev:api`) ---
# Puerto de la API local.
API_PORT=3001
# Secreto de los access tokens. En desarrollo se genera uno por arranque; en producción es
# obligatorio (32+ caracteres).
# JWT_SECRET=
# Orígenes de navegador autorizados (protección CSRF), separados por comas.
# ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173
